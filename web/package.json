{
  "name": "safetics-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "api:generate": "node scripts/generate-api.mjs",
    "e2e": "docker compose -f ../server/docker-compose.yml up -d --wait postgres-e2e && playwright test",
    "e2e:ui": "docker compose -f ../server/docker-compose.yml up -d --wait postgres-e2e && playwright test --ui",
    "e2e:report": "playwright show-report",
    "e2e:reset": "docker compose -f ../server/docker-compose.yml rm -sf postgres-e2e",
    "e2e:typecheck": "tsc -p e2e"
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.4",
    "@tanstack/react-query": "^5.108.2",
    "antd": "^6.7.1",
    "dayjs": "^1.11.23",
    "i18next": "^27.2.2",
    "openapi-fetch": "^0.17.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^18.0.3",
    "react-router": "^8.5.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.90.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.6"
  }
}
